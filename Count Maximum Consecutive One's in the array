import java.util.*;

class Main {
    public static void main(String[] args) {
        int[] arr={1,1,1,0,0,1,1,1,1,1,0};
        int max=0;
        int count=0;
        for(int i=0;i<=10;i++)
        {
            count=0;
            if(arr[i]==1)
            {
                count++;
            }
            for(int j=i+1;j<=10;j++)
            {
                if(arr[j]!=1)
                {
                    count=0;
                }
                else
                {
                    count++;
                }
                if(count>max)
                max=count;
            }
            }
            System.out.println(max);
    }
}
